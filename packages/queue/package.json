{
  "name": "@nextorders/queue",
  "type": "module",
  "version": "0.4.2",
  "description": "Designed to simplify working with RabbitMQ in Node.js applications. Provides a high-level API for organizing message queues and processing business entities.",
  "license": "MIT",
  "homepage": "https://nextorders.ru/queue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextorders/queue.git",
    "directory": "packages/queue"
  },
  "keywords": [
    "queue",
    "rabbitmq",
    "publisher",
    "consumer",
    "nextorders"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./README.md": "./README.md"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "clean:modules": "rm -rf dist node_modules"
  },
  "dependencies": {
    "rabbitmq-client": "catalog:integrations"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "unbuild": "catalog:dev"
  }
}
